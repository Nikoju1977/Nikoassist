{
  "name": "NikoAssist — Niko Studio Design",
  "short_name": "NikoAssist",
  "description": "Assistant IA gratuit fonctionnant sur le téléphone avec un petit modèle libre. Mode local sans serveur ni clé API ; fonctions avancées selon le moteur connecté.",
  "id": "/",
  "start_url": "/local.html",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "lang": "fr",
  "dir": "ltr",
  "background_color": "#10192b",
  "theme_color": "#10192b",
  "categories": [
    "productivity",
    "utilities"
  ],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
