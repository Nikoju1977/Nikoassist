{
  "name": "NikoAssist Web — Studio Niko",
  "short_name": "NikoAssist",
  "description": "Assistant web public sans clé : recherche, météo, tâches et voix.",
  "start_url": "./",
  "scope": "./",
  "id": "./",
  "display": "standalone",
  "theme_color": "#080d18",
  "background_color": "#080d18",
  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "prefer_related_applications": false
}